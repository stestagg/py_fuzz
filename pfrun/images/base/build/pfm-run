#!/bin/sh

set -u

ulimit -Hn 4194304
ulimit -Sn 4194304

BLUE='\033[34m'
GREEN='\033[32m'
RED='\033[31m'
BOLD='\033[1m'
RESET='\033[0m'

cmdline="$(cat /proc/cmdline)"

case " $cmdline " in
    *" pfmscript="*)
        script_b64="$(printf '%s\n' "$cmdline" | sed -n 's/.*pfmscript=\([^ ]*\).*/\1/p')"
        script_cmd="$(printf '%s' "$script_b64" | base64 -d 2>/dev/null)"
        decode_status=$?

        if [ "$decode_status" -eq 0 ] && [ -n "$script_cmd" ]; then
            case " $cmdline " in
                *" pfmenv="*)
                    env_file="$(printf '%s\n' "$cmdline" | sed -n 's/.*pfmenv=\([^ ]*\).*/\1/p')"
                    if [ -f "$env_file" ]; then
                        . "$env_file"
                    else
                        printf '[PFM] env file not found: %s\n' "$env_file" > /dev/hvc1
                    fi
                    ;;
            esac

            case " $cmdline " in
                *" pfminteractive=1 "*)
                    # Apply initial terminal size so programs like tmux get a valid geometry.
                    pfm_rows=$(printf '%s\n' "$cmdline" | sed -n 's/.*pfmrows=\([^ ]*\).*/\1/p')
                    pfm_cols=$(printf '%s\n' "$cmdline" | sed -n 's/.*pfmcols=\([^ ]*\).*/\1/p')
                    if [ -n "$pfm_rows" ] && [ -n "$pfm_cols" ]; then
                        stty rows "$pfm_rows" cols "$pfm_cols" < /dev/hvc1 2>/dev/null || true
                    fi

                    # Forward terminal resize events: the host writes "R:rows:cols\n" to
                    # hvc0's read side on SIGWINCH; pick them up and apply with stty.
                    while IFS= read -r pfm_resize_line < /dev/hvc0; do
                        case "$pfm_resize_line" in
                            R:*:*)
                                pfm_r=$(printf '%s' "$pfm_resize_line" | cut -d: -f2)
                                pfm_c=$(printf '%s' "$pfm_resize_line" | cut -d: -f3)
                                stty rows "$pfm_r" cols "$pfm_c" < /dev/hvc1 2>/dev/null || true
                                ;;
                        esac
                    done &
                    pfm_resize_pid=$!

                    printf "${BLUE}${BOLD}[PFM] Running %s${RESET}\n" "$script_cmd" > /dev/hvc1
                    mkdir -p /dev/pts
                    mount -t devpts devpts /dev/pts 2>/dev/null || true
                    # Open /dev/hvc1 *inside* the new session created by setsid, so the
                    # kernel automatically assigns it as the controlling terminal without
                    # needing an explicit TIOCSCTTY ioctl (cttyhack).
                    # setsid sh -c 'exec "$0" < /dev/hvc1 > /dev/hvc1 2>&1' "$script_cmd"
                    # setsid cttyhack sh -lc "$script_cmd" < /dev/hvc1 > /dev/hvc1 2>&1
                    setsid /usr/local/bin/pfm-pty /dev/hvc1 -- sh -c "$script_cmd"

                    kill "$pfm_resize_pid" 2>/dev/null || true
                    ;;
                *)
                    printf "${BLUE}${BOLD}[PFM] Running %s${RESET}\n" "$script_cmd" > /dev/hvc1
                    sh -c "$script_cmd" > /dev/hvc1 2>&1
                    ;;
            esac
            cmd_status=$?
            if [ "$cmd_status" -eq 0 ]; then
                STATUS_COLOR="$GREEN"
            else
                STATUS_COLOR="$RED"
            fi
            printf "${STATUS_COLOR}${BOLD}[PFM] command exited with status: %s${RESET}\n" "$cmd_status" > /dev/hvc1

            if command -v poweroff >/dev/null 2>&1; then
                poweroff -f > /dev/hvc0 2>&1 || poweroff > /dev/hvc0 2>&1
            elif command -v halt >/dev/null 2>&1; then
                halt -f > /dev/hvc0 2>&1 || halt > /dev/hvc0 2>&1
            fi
            exit "$cmd_status"
        else
            printf '[PFM] invalid pfmscript payload\n' > /dev/hvc1
        fi
        ;;
esac
