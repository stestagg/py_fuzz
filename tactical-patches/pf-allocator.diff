diff --git a/Include/cpython/pymem.h b/Include/cpython/pymem.h
index 76b3221f7b9..28958260697 100644
--- a/Include/cpython/pymem.h
+++ b/Include/cpython/pymem.h
@@ -82,3 +82,18 @@ PyAPI_FUNC(void) PyMem_SetAllocator(PyMemAllocatorDomain domain,
 
    The function does nothing if Python is not compiled is debug mode. */
 PyAPI_FUNC(void) PyMem_SetupDebugHooks(void);
+
+/* Install a fault-injecting allocator hook with the ``Pf`` prefix on all
+   memory domains.  The hook preserves and delegates to the current allocator.
+   Installation and removal must be serialized with allocator changes. */
+PyAPI_FUNC(int) PyMem_PfInstall(void);
+PyAPI_FUNC(int) PyMem_PfUninstall(void);
+
+/* Set the number of memory-pressure-increasing allocation calls remaining and
+   an optional size filter.  A positive count is decremented for each
+   malloc/calloc or growing realloc whose size matches alloc_size (or for all
+   sizes when alloc_size is zero); the call which decrements count to zero
+   fails.  Zero count disables fault injection.  When a fault fires, alloc_size
+   is reset to zero. */
+PyAPI_FUNC(void) PyMem_PfSetCounter(Py_ssize_t count, size_t alloc_size);
+PyAPI_FUNC(Py_ssize_t) PyMem_PfGetCounter(void);
