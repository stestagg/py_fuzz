+static PyObject *
+test_pymem_pf_allocator(PyObject *self, PyObject *Py_UNUSED(ignored))
+{
+    void *ptr = NULL;
+    void *new_ptr;
+    const char *error = NULL;
+
+    if (PyMem_PfInstall() < 0) {
+        return PyErr_Format(PyExc_RuntimeError, "failed to install Pf allocator");
+    }
+
+    PyMem_PfSetCounter(2, 0);
+    ptr = PyMem_RawMalloc(32);
+    if (ptr == NULL || PyMem_PfGetCounter() != 1) {
+        error = "first allocation did not decrement the counter";
+        goto done;
+    }
+    new_ptr = PyMem_RawMalloc(32);
+    if (new_ptr != NULL || PyMem_PfGetCounter() != 0) {
+        PyMem_RawFree(new_ptr);
+        error = "allocation reaching zero did not fail";
+        goto done;
+    }
+    new_ptr = PyMem_RawMalloc(32);
+    if (new_ptr == NULL) {
+        error = "allocation at zero did not delegate";
+        goto done;
+    }
+    PyMem_RawFree(new_ptr);
+
+    PyMem_PfSetCounter(2, 0);
+    new_ptr = PyMem_RawRealloc(ptr, 16);
+    if (new_ptr == NULL || PyMem_PfGetCounter() != 1) {
+        error = "realloc did not decrement the counter";
+        goto done;
+    }
+    ptr = new_ptr;
+    new_ptr = PyMem_RawRealloc(ptr, 64);
+    if (new_ptr != NULL || PyMem_PfGetCounter() != 0) {
+        if (new_ptr != NULL) {
+            ptr = new_ptr;
+        }
+        error = "realloc reaching zero did not fail";
+        goto done;
+    }
+
+    PyMem_PfSetCounter(1, 0);
+    new_ptr = PyMem_RawCalloc(2, 16);
+    if (new_ptr != NULL || PyMem_PfGetCounter() != 0) {
+        PyMem_RawFree(new_ptr);
+        error = "calloc reaching zero did not fail";
+        goto done;
+    }
+
+done:
+    PyMem_PfSetCounter(0, 0);
+    PyMem_RawFree(ptr);
+    if (PyMem_PfUninstall() < 0 && error == NULL) {
+        error = "failed to uninstall Pf allocator";
+    }
+    if (error != NULL) {
+        return PyErr_Format(PyExc_AssertionError, "%s", error);
+    }
+    Py_RETURN_NONE;
+}
