diff --git a/Modules/pfalloc.c b/Modules/pfalloc.c
new file mode 100644
index 00000000000..0a450629cd6
--- /dev/null
+++ b/Modules/pfalloc.c
@@ -0,0 +1,71 @@
+/* Python module exposing the fault-injecting allocator hook. */
+
+#ifndef Py_BUILD_CORE_BUILTIN
+#  define Py_BUILD_CORE_MODULE 1
+#endif
+
+#include "Python.h"
+
+static PyObject *
+pfalloc_enable(PyObject *module, PyObject *args)
+{
+    PyMem_PfInstall();
+    Py_RETURN_NONE;
+}
+
+static PyObject *
+pfalloc_disable(PyObject *module, PyObject *args)
+{
+    if (PyMem_PfUninstall() < 0) {
+        PyErr_SetString(PyExc_RuntimeError,
+            "cannot uninstall pfalloc: another allocator hook is layered on top");
+        return NULL;
+    }
+    Py_RETURN_NONE;
+}
+
+static PyObject *
+pfalloc_set_counter(PyObject *module, PyObject *args)
+{
+    Py_ssize_t n;
+    Py_ssize_t alloc_size = 0;
+    if (!PyArg_ParseTuple(args, "n|n", &n, &alloc_size)) {
+        return NULL;
+    }
+    if (alloc_size < 0) {
+        alloc_size = 0;
+    }
+    PyMem_PfSetCounter(n, (size_t)alloc_size);
+    Py_RETURN_NONE;
+}
+
+static PyMethodDef pfalloc_methods[] = {
+    {"enable",      pfalloc_enable,      METH_NOARGS,
+     "Install the fault-injecting allocator hook."},
+    {"disable",     pfalloc_disable,     METH_NOARGS,
+     "Uninstall the fault-injecting allocator hook."},
+    {"set_counter", pfalloc_set_counter, METH_VARARGS,
+     "set_counter(n, alloc_size=0)\n"
+     "Set the allocation failure countdown.  The Nth allocation of alloc_size\n"
+     "bytes fails (0 means all sizes)."},
+    {NULL, NULL}
+};
+
+static PyModuleDef_Slot pfalloc_slots[] = {
+    _Py_ABI_SLOT,
+    {Py_mod_gil, Py_MOD_GIL_NOT_USED},
+    {0, NULL}
+};
+
+static struct PyModuleDef pfalloc_module = {
+    PyModuleDef_HEAD_INIT,
+    .m_name    = "pfalloc",
+    .m_methods = pfalloc_methods,
+    .m_slots   = pfalloc_slots,
+};
+
+PyMODINIT_FUNC
+PyInit_pfalloc(void)
+{
+    return PyModuleDef_Init(&pfalloc_module);
+}
diff --git a/Objects/pfalloc.c b/Objects/pfalloc.c
new file mode 100644
index 00000000000..5ff9cf52340
--- /dev/null
+++ b/Objects/pfalloc.c
@@ -0,0 +1,164 @@
+/* Fault-injecting Python memory allocator wrapper. */
+
+#include "Python.h"
+
+#include <stdlib.h>
+
+
+typedef struct {
+    PyMemAllocatorEx wrapped;
+} PfAllocator;
+
+static struct {
+    int installed;
+    PfAllocator raw;
+    PfAllocator mem;
+    PfAllocator obj;
+} PfState;
+
+static Py_ssize_t PfCounter;
+static Py_ssize_t PfAllocSize;
+
+
+static volatile int PfFailedCount;
+
+Py_NO_INLINE void
+PyMem_PfFailed(void)
+{
+    /* Breakpoint target: set a debugger breakpoint here to catch injected failures. */
+    ++PfFailedCount;
+}
+
+static int
+PfShouldFail(size_t size)
+{
+    Py_ssize_t alloc_size = _Py_atomic_load_ssize(&PfAllocSize);
+    if (alloc_size != 0 && (Py_ssize_t)size != alloc_size) {
+        return 0;
+    }
+    Py_ssize_t counter = _Py_atomic_load_ssize(&PfCounter);
+    while (counter > 0) {
+        Py_ssize_t next = counter - 1;
+        if (_Py_atomic_compare_exchange_ssize(&PfCounter, &counter, next)) {
+            if (next == 0) {
+                _Py_atomic_store_ssize(&PfAllocSize, 0);
+                PyMem_PfFailed();
+                return 1;
+            }
+            return 0;
+        }
+    }
+    return 0;
+}
+
+static void *
+PfMalloc(void *ctx, size_t size)
+{
+    PfAllocator *allocator = ctx;
+    if (PfShouldFail(size)) {
+        return NULL;
+    }
+    return allocator->wrapped.malloc(allocator->wrapped.ctx, size);
+}
+
+static void *
+PfCalloc(void *ctx, size_t nelem, size_t elsize)
+{
+    PfAllocator *allocator = ctx;
+    if (PfShouldFail(nelem * elsize)) {
+        return NULL;
+    }
+    return allocator->wrapped.calloc(allocator->wrapped.ctx, nelem, elsize);
+}
+
+static void *
+PfRealloc(void *ctx, void *ptr, size_t new_size)
+{
+    PfAllocator *allocator = ctx;
+    if (PfShouldFail(new_size)) {
+        return NULL;
+    }
+    return allocator->wrapped.realloc(allocator->wrapped.ctx, ptr, new_size);
+}
+
+static void
+PfFree(void *ctx, void *ptr)
+{
+    PfAllocator *allocator = ctx;
+    allocator->wrapped.free(allocator->wrapped.ctx, ptr);
+}
+
+static void
+PfInstallDomain(PyMemAllocatorDomain domain, PfAllocator *allocator)
+{
+    PyMemAllocatorEx hook = {
+        .ctx = allocator,
+        .malloc = PfMalloc,
+        .calloc = PfCalloc,
+        .realloc = PfRealloc,
+        .free = PfFree,
+    };
+    PyMem_GetAllocator(domain, &allocator->wrapped);
+    PyMem_SetAllocator(domain, &hook);
+}
+
+int
+PyMem_PfInstall(void)
+{
+    if (PfState.installed) {
+        return 0;
+    }
+    PfInstallDomain(PYMEM_DOMAIN_RAW, &PfState.raw);
+    PfInstallDomain(PYMEM_DOMAIN_MEM, &PfState.mem);
+    PfInstallDomain(PYMEM_DOMAIN_OBJ, &PfState.obj);
+    PfState.installed = 1;
+    return 0;
+}
+
+static int
+PfDomainIsInstalled(PyMemAllocatorDomain domain, PfAllocator *allocator)
+{
+    PyMemAllocatorEx current;
+    PyMem_GetAllocator(domain, &current);
+    return (current.ctx == allocator &&
+            current.malloc == PfMalloc &&
+            current.calloc == PfCalloc &&
+            current.realloc == PfRealloc &&
+            current.free == PfFree);
+}
+
+int
+PyMem_PfUninstall(void)
+{
+    if (!PfState.installed) {
+        return 0;
+    }
+    if (!PfDomainIsInstalled(PYMEM_DOMAIN_RAW, &PfState.raw) ||
+        !PfDomainIsInstalled(PYMEM_DOMAIN_MEM, &PfState.mem) ||
+        !PfDomainIsInstalled(PYMEM_DOMAIN_OBJ, &PfState.obj)) {
+        return -1;
+    }
+
+    PyMem_SetAllocator(PYMEM_DOMAIN_RAW, &PfState.raw.wrapped);
+    PyMem_SetAllocator(PYMEM_DOMAIN_MEM, &PfState.mem.wrapped);
+    PyMem_SetAllocator(PYMEM_DOMAIN_OBJ, &PfState.obj.wrapped);
+    PfState.installed = 0;
+    PyMem_PfSetCounter(0, 0);
+    return 0;
+}
+
+void
+PyMem_PfSetCounter(Py_ssize_t count, size_t alloc_size)
+{
+    if (count < 0) {
+        count = 0;
+    }
+    _Py_atomic_store_ssize(&PfAllocSize, (Py_ssize_t)alloc_size);
+    _Py_atomic_store_ssize(&PfCounter, count);
+}
+
+Py_ssize_t
+PyMem_PfGetCounter(void)
+{
+    return _Py_atomic_load_ssize(&PfCounter);
+}
