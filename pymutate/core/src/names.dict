__repr__
__str__
__hash__
__eq__
__len__
__iter__
__next__
__enter__
__exit__
__index__
__reduce__
__reduce_ex__
__sizeof__
__slots__
__weakref__
__code__
__globals__
__closure__
__defaults__
__annotations__
__builtins__

# --- misc short identifiers useful for shadowing / self-reference ---
self
cls
_
x
