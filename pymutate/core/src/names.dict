# Name-substitution candidates for the NameSubstitution sub-mutator.
# One identifier per line. Blank lines and lines starting with '#' are ignored.
# Edit this file to broaden mutation coverage; no logic recompile of the
# mutators is required (it is include_str!'d into the binary).

# --- singletons / constants ---
None
True
False
Ellipsis
NotImplemented
__debug__

# --- common builtins (callables that tend to reach interesting C paths) ---
len
range
print
repr
str
bytes
bytearray
memoryview
int
float
complex
bool
list
tuple
dict
set
frozenset
type
object
super
iter
next
enumerate
zip
map
filter
reversed
sorted
slice
hash
id
vars
dir
getattr
setattr
delattr
hasattr
callable
isinstance
issubclass
compile
eval
exec
globals
locals
open
input
format
ord
chr
hex
oct
bin
abs
min
max
sum
pow
divmod
round
staticmethod
classmethod
property

# --- exceptions ---
Exception
BaseException
ValueError
TypeError
KeyError
IndexError
AttributeError
RuntimeError
StopIteration
StopAsyncIteration
GeneratorExit
SystemExit
KeyboardInterrupt
MemoryError
OverflowError
RecursionError

# --- dunder attributes (frequently hit descriptor / slot machinery) ---
__class__
__dict__
__doc__
__name__
__qualname__
__module__
__bases__
__mro__
__subclasses__
__init__
__new__
